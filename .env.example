# Execution Environment: local (DuckDB, $0 cost) | gcp (GCS + BigQuery)
APP_ENV=local
TARGET_BACKEND=local

# Local DuckDB Warehouse Path
LOCAL_DUCKDB_PATH=data/warehouse/saas_revenue.duckdb
LOCAL_DATA_DIR=data/raw
LOCAL_QUARANTINE_DIR=data/quarantine

# Synthetic Data Generator (deterministic seed)
GENERATOR_SEED=42
NUM_ACCOUNTS=250

# GCP Configuration (only required when TARGET_BACKEND=gcp)
# NEVER commit real project IDs, billing IDs, or service account keys to .env!
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_RAW_BUCKET=your-gcp-project-id-saas-rev-raw-dev
GCP_BQ_DATASET_RAW=raw
GCP_BQ_DATASET_MARTS=marts
